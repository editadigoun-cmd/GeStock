{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestock-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "ACCESS_ISSUER": "https://dark-bush-1837.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "4143db25e4dd2576066db38722c7c5138f9a17f699eafef5d8ab85c95162c689",
    "ADMIN_EMAIL": "editadigoun@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestock-db",
      "database_id": "8db6e3fb-dae4-41c2-8a98-37b6421ca0be",
      "migrations_dir": "migrations"
    }
  ],
}
