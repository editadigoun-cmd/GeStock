{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestock-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "AUTH_ISSUER": "https://ep-holy-boat-banyu93m.neonauth.c-8.eu-central-1.aws.neonauth.tech",
    "AUTH_JWKS_URL": "https://ep-holy-boat-banyu93m.neonauth.c-8.eu-central-1.aws.neonauth.tech/gestock/auth/.well-known/jwks.json"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestock-db",
      "database_id": "8db6e3fb-dae4-41c2-8a98-37b6421ca0be",
      "migrations_dir": "migrations"
    }
  ],
}
